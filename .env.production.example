# Variables de producción — en Dokploy se pegan en Environment del servicio Compose.
# NUNCA subas el archivo real al repositorio.

# Contraseña del Postgres interno (genera una: openssl rand -hex 24)
POSTGRES_PASSWORD=""

# Dominio de producción, sin barra final (canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://misescorts.com"

# Web Push (VAPID). Genera un par NUEVO para producción:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:lassojuanfe@gmail.com"

# WhatsApp vía el gateway propio (wa-baileys-backend). Opcional: sin estas
# variables no se envía nada. WA_API_KEY debe ser una clave de SCOPED_API_KEYS
# del gateway limitada a WA_CLIENT_ID (no la API_KEY principal).
WA_API_URL="https://wa.tu-dominio.com"
WA_API_KEY=""
WA_CLIENT_ID="misescorts"
# Mismo valor que MISESCORTS_WEBHOOK_SECRET en el gateway (openssl rand -hex 32)
WA_WEBHOOK_SECRET=""
# Máximo de invitaciones en 24 h y país por defecto para teléfonos sin indicativo
WA_DAILY_LIMIT="20"
WA_DEFAULT_COUNTRY="CO"
